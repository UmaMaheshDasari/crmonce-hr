# ─────────────────────────────────────────────────────────────
#  HR System — Backend Environment Variables
#  Copy this file to .env and fill in your values:  cp .env.example .env
#  Vars marked (required) must be set or the app fails at first request.
#  All other vars have safe in-code defaults and are optional.
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production                 # 'development' opens permissive CORS — use 'production' in prod
TRUST_PROXY_HOPS=1                  # number of proxy hops in front of the app (nginx = 1)

# ── Azure AD (app-only auth for D365 + Microsoft Graph) ───────  (required)
# From portal.azure.com → App registrations. Single-tenant recommended.
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# ── Dynamics 365 (Dataverse) ──────────────────────────────────  (required)
D365_BASE_URL=https://yourorg.crm.dynamics.com    # no trailing slash
D365_API_VERSION=9.2

# ── JWT ───────────────────────────────────────────────────────  (JWT_SECRET required)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
APPROVAL_TOKEN_SECRET=                # optional; falls back to JWT_SECRET for email approval links
APPROVAL_LINK_EXPIRY=7d

# ── Email — sent via Microsoft Graph (app-only), NOT SMTP ─────
# The mailbox the system sends from. WITHOUT this, outbound email silently no-ops.
GRAPH_SENDER=hr@yourorg.com
EMAIL_DRY_RUN=false                   # true = log emails instead of sending (safe for staging)
HR_INFO_EMAIL=hr@yourorg.com
EMAIL_SUPPORT=support@yourorg.com
TENANT_MAIL_DOMAINS=yourorg.com       # comma-separated allowed sender domains
# Branding (optional, all have defaults)
EMAIL_BRAND_NAME=CRMONCE HR
EMAIL_BRAND_TAGLINE=
EMAIL_BRAND_PRIMARY=
EMAIL_BRAND_PRIMARY_DARK=
EMAIL_BRAND_NAVY=

# ── Frontend / CORS ───────────────────────────────────────────
FRONTEND_URL=https://hr.yourorg.com   # allowed CORS origin + link base in emails
APP_URL=https://hr.yourorg.com        # fallback for FRONTEND_URL in some link builders

# ── File uploads ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760                 # 10 MB

# ── Biometric device (ZKTeco push) — optional ────────────────
# The push port must be FIREWALLED to the device network (unauthenticated TCP).
ZK_DEVICE_IP=192.168.1.199
ZK_DEVICE_PORT=4370
ZK_PUSH_PORT=9922
ZK_TIMEOUT=10000

# ── Timezone / calendar ───────────────────────────────────────
APP_TIMEZONE=Asia/Kolkata
WEEK_OFF_DAYS=0,6                      # 0=Sun … 6=Sat (comma-separated)
HOLIDAYS=                             # optional comma-separated YYYY-MM-DD; HR calendar is the primary source
SHIFTS_JSON=                          # optional JSON of named shifts
DEFAULT_SHIFT=General Shift
DEFAULT_SHIFT_HOURS=9

# ── Attendance / leave policy (optional — all have defaults) ──
POLICY_REQUIRED_HOURS=9
POLICY_HALFDAY_HOURS=4.5
POLICY_OVERTIME_AFTER_HOURS=9
POLICY_GRACE_MINUTES=10
LATE_GRACE_MINUTES=10
EARLY_GRACE_MINUTES=10
POLICY_LATE_DEDUCTION=false
POLICY_LUNCH_DEDUCTION=false
POLICY_COMPENSATION_ENABLED=false
POLICY_MONTHLY_PAID_LEAVE=1.5
ANNUAL_LEAVE_ENTITLEMENT=18
SALARY_DAY=1

# ── Background jobs / automation (optional) ───────────────────
AUTO_PROVISION=true                    # auto-create Dataverse tables/columns on boot
AUTO_PAYROLL=false                     # month-end auto payroll cron
ATTENDANCE_EXCEPTION_SCAN=true
LEAVE_REMINDERS_ENABLED=false
LEAVE_REMINDER_CRON=0 * * * *
LEAVE_REMINDER_HOURS=24
LEAVE_ESCALATE_HOURS=48
NOTIFY_CC_ON_DECISION=true
GOAL_CC_HR=true
TEAMS_WEBHOOK_URL=                     # optional Teams notifications

# ── Defaults for auto-provisioned employees (optional) ────────
DEFAULT_MANAGER_ID=
DEFAULT_MANAGER_NAME=
