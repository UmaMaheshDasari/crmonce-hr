# CRMONCE HR — Office eTime Sync Agent configuration.
# Copy to ".env" and fill in real values. NEVER commit the real .env.

# Production HR backend base URL (HTTPS). No trailing slash.
HR_API_URL=https://hr.crmonce.com

# Shared secret that authenticates this agent to the backend.
# MUST match ETIME_AGENT_KEY set on the production backend. Generate a long random value.
ETIME_AGENT_KEY=

# Office ZK/eTime device on the LAN.
ZK_DEVICE_IP=192.168.1.199
ZK_DEVICE_PORT=4370
ZK_TIMEOUT=10000

# How often to read the device and flush the spool (milliseconds).
SYNC_INTERVAL_MS=60000
# Max punches per HTTPS batch.
SYNC_BATCH_SIZE=500

# Where the local unsent-punch spool is stored (defaults to ./spool.json next to agent.js).
# SPOOL_FILE=C:\crmonce-agent\spool.json
